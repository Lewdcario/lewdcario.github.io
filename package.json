{
	"name": "portfolio",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"dev": "nuxt dev",
		"dev:tor": "./scripts/dev-tor.sh",
		"dev:remote": "yarn docker:up && NUXT_PUBLIC_REMOTE_SIGNAL_WS=ws://localhost:8080/signal/ws nuxt dev --host 0.0.0.0 --port 3000",
		"build": "nuxt build",
		"preview": "nuxt preview",
		"yarn:docker": "yarn docker:up",
		"docker:up": "docker compose --profile remote up -d tor remote-signaling nginx",
		"docker:down": "docker compose stop tor remote-signaling nginx && docker compose rm -f tor remote-signaling nginx",
		"docker:logs": "docker compose --profile remote logs -f tor remote-signaling nginx",
		"tor:up": "docker compose up -d tor",
		"tor:down": "docker compose down",
		"tor:logs": "docker compose logs -f tor",
		"remote:up": "docker compose --profile remote up -d remote-signaling nginx",
		"remote:down": "docker compose stop remote-signaling nginx && docker compose rm -f remote-signaling nginx",
		"remote:logs": "docker compose --profile remote logs -f remote-signaling nginx",
		"test:unit": "vitest",
		"test:e2e": "start-server-and-test 'nuxt preview --port 4173' http://localhost:4173 'cypress run --e2e'",
		"test:e2e:dev": "start-server-and-test 'nuxt dev --port 4173' http://localhost:4173 'cypress open --e2e'",
		"build-only": "nuxt build",
		"type-check": "nuxt prepare",
		"lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
		"format": "prettier --write src/",
		"prepare": "husky",
		"precommit": "npx lint-staged"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"@vue/compat": "^3.5.28",
		"@vueuse/head": "^2.0.0",
		"bootstrap": "^5.3.8",
		"bootstrap-vue": "^2.23.1",
		"drizzle-orm": "^0.45.1",
		"markdown-it": "^14.1.1",
		"pg": "^8.18.0",
		"playwright": "^1.58.2",
		"postgres": "^3.4.8",
		"unhead": "^2.1.4",
		"vue": "^3.5.28",
		"vue-router": "^5.0.3",
		"vue-virtual-scroller": "^2.0.0-beta.8",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@rushstack/eslint-patch": "^1.16.1",
		"@tsconfig/node22": "^22.0.5",
		"@types/jsdom": "^27.0.0",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^25.3.0",
		"@types/pg": "^8.16.0",
		"@typescript-eslint/eslint-plugin": "^8.56.0",
		"@typescript-eslint/parser": "^8.56.0",
		"@vitejs/plugin-vue": "^6.0.4",
		"@vitejs/plugin-vue-jsx": "^5.1.4",
		"@vue/eslint-config-prettier": "^10.2.0",
		"@vue/eslint-config-typescript": "^14.7.0",
		"@vue/test-utils": "^2.4.6",
		"@vue/tsconfig": "^0.8.1",
		"cypress": "^15.10.0",
		"eslint": "^9.39.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-cypress": "^6.1.0",
		"eslint-plugin-prettier": "^5.5.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-vue": "^10.8.0",
		"husky": "^9.1.7",
		"jsdom": "^28.1.0",
		"npm-run-all": "^4.1.5",
		"nuxt": "^4.3.1",
		"prettier": "^3.8.1",
		"start-server-and-test": "^2.1.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"vue-eslint-parser": "^10.4.0",
		"vue-tsc": "^3.2.5"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.ts": [
			"prettier --write",
			"eslint --fix"
		],
		"*.tsx": [
			"prettier --write",
			"eslint --fix"
		],
		"*.vue": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"packageManager": "yarn@4.7.0+sha512.5a0afa1d4c1d844b3447ee3319633797bcd6385d9a44be07993ae52ff4facabccafb4af5dcd1c2f9a94ac113e5e9ff56f6130431905884414229e284e37bb7c9"
}
